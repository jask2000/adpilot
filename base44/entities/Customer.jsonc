{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "total_orders": {
      "type": "number",
      "default": 0
    },
    "total_spent": {
      "type": "number",
      "default": 0
    },
    "avg_order_value": {
      "type": "number",
      "default": 0
    },
    "first_order_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_order_date": {
      "type": "string",
      "format": "date-time"
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "order_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_store": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}